<?xml version='1.0'?>
<ruleset name='12 Step Meeting List'>
    <description>Coding standards for 12 Step Meeting List.</description>

    <file>.</file>

    <arg name='encoding' value='utf-8'/>
    <arg name='extensions' value='php'/>
    <arg name='warning-severity' value='6'/>
    <arg name="report" value="full"/>
    <arg name="parallel" value="4"/>
    <arg value='sp'/>

    <ini name="memory_limit" value="128M"/>

    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
    <!-- Compiled output; format the sources in assets/src instead. -->
    <exclude-pattern>assets/build/*</exclude-pattern>

    <rule ref="PSR12">
        <!-- WordPress test classes conventionally use Snake_Case names. -->
        <exclude name="Squiz.Classes.ValidClassName"/>
        <!-- WordPress test methods conventionally use snake_case names. -->
        <exclude name="PSR1.Methods.CamelCapsMethodName"/>
        <!-- WordPress test cases are global classes, not namespaced. -->
        <exclude name="PSR1.Classes.ClassDeclaration.MissingNamespace"/>
        <!-- includes/widgets.php declares all of the plugin's widgets together. -->
        <exclude name="PSR1.Classes.ClassDeclaration.MultipleClasses"/>
    </rule>
</ruleset>
